{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inference-autopilot:schema:policy-bundle:1.0",
  "title": "Inference Autopilot Guarded Policy Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer",
    "policy_id",
    "status",
    "selection_spec_sha256",
    "compiled_space_sha256",
    "feature_table_sha256",
    "selection_spec",
    "response_model",
    "training",
    "activation_guard",
    "selected",
    "fallback",
    "ranked_candidates",
    "audit",
    "policy_bundle_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "producer": {"type": "string", "minLength": 1},
    "policy_id": {"$ref": "#/$defs/id"},
    "status": {
      "enum": ["selected", "insufficient_evidence", "no_feasible_candidate"]
    },
    "selection_spec_sha256": {"$ref": "#/$defs/digest"},
    "compiled_space_sha256": {"$ref": "#/$defs/digest"},
    "feature_table_sha256": {"$ref": "#/$defs/digest"},
    "selection_spec": {"type": "object"},
    "response_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "feature_dimensions",
        "target_scales",
        "replicate_noise_floors"
      ],
      "properties": {
        "kind": {
          "const": "normalized_inverse_distance_support_points_replicate_floor"
        },
        "feature_dimensions": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/dimension"}
        },
        "target_scales": {
          "type": "object",
          "additionalProperties": {"type": "number", "exclusiveMinimum": 0}
        },
        "replicate_noise_floors": {
          "type": "object",
          "additionalProperties": {"type": "number", "minimum": 0}
        }
      }
    },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "required": ["response_row_ids", "feasibility_row_ids", "exclusions"],
      "properties": {
        "response_row_ids": {"$ref": "#/$defs/stringArray"},
        "feasibility_row_ids": {"$ref": "#/$defs/stringArray"},
        "exclusions": {"$ref": "#/$defs/countMap"}
      }
    },
    "activation_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm_id",
        "semantic_cohort_id",
        "graph_sha256",
        "workload_id",
        "environment_id",
        "exact_static_features",
        "static_feature_ranges",
        "maximum_normalized_distance",
        "maximum_failure_probability",
        "slo_constraints",
        "on_violation"
      ],
      "properties": {
        "algorithm_id": {"$ref": "#/$defs/id"},
        "semantic_cohort_id": {"$ref": "#/$defs/id"},
        "graph_sha256": {"$ref": "#/$defs/digest"},
        "workload_id": {"$ref": "#/$defs/id"},
        "environment_id": {"$ref": "#/$defs/id"},
        "exact_static_features": {"$ref": "#/$defs/scalarMap"},
        "static_feature_ranges": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/range"}
        },
        "maximum_normalized_distance": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_failure_probability": {"type": "number", "minimum": 0, "maximum": 1},
        "slo_constraints": {
          "type": "array",
          "items": {"$ref": "#/$defs/constraint"}
        },
        "on_violation": {"const": "fallback"}
      }
    },
    "selected": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/evaluation"}]
    },
    "fallback": {"$ref": "#/$defs/fallback"},
    "ranked_candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/evaluation"}
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiled_candidate_count",
        "evaluated_candidate_count",
        "eligible_candidate_count",
        "reported_candidate_count",
        "rejections_by_reason"
      ],
      "properties": {
        "compiled_candidate_count": {"type": "integer", "minimum": 0},
        "evaluated_candidate_count": {"type": "integer", "minimum": 0},
        "eligible_candidate_count": {"type": "integer", "minimum": 0},
        "reported_candidate_count": {"type": "integer", "minimum": 0},
        "rejections_by_reason": {"$ref": "#/$defs/countMap"}
      }
    },
    "policy_bundle_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scalar": {"type": ["boolean", "number", "string"]},
    "settingValue": {
      "oneOf": [
        {"type": ["boolean", "number", "string"]},
        {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        }
      ]
    },
    "scalarMap": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/scalar"}
    },
    "settingMap": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/settingValue"}
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "countMap": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {"type": "number"},
        "maximum": {"type": "number"}
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "operator", "value"],
      "properties": {
        "target": {"type": "string", "minLength": 1},
        "operator": {"enum": ["<=", ">="]},
        "value": {"type": "number"}
      }
    },
    "dimension": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "minimum", "maximum"],
          "properties": {
            "kind": {"const": "numeric"},
            "minimum": {"type": "number"},
            "maximum": {"type": "number"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "categorical"}}
        }
      ]
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mean", "lower", "upper", "uncertainty"],
      "properties": {
        "mean": {"type": "number"},
        "lower": {"type": "number"},
        "upper": {"type": "number"},
        "uncertainty": {"type": "number", "minimum": 0}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "nearest_normalized_distance",
        "failure_probability",
        "target_estimates",
        "paired_objective_effect",
        "response_neighbor_row_ids",
        "feasibility_neighbor_row_ids",
        "eligible",
        "rejection_reasons",
        "deployment_settings",
        "requires_engine_restart"
      ],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/id"},
        "nearest_normalized_distance": {"type": "number", "minimum": 0},
        "failure_probability": {"type": "number", "minimum": 0, "maximum": 1},
        "target_estimates": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/estimate"}
        },
        "paired_objective_effect": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/pairedEffect"}]
        },
        "response_neighbor_row_ids": {"$ref": "#/$defs/stringArray"},
        "feasibility_neighbor_row_ids": {"$ref": "#/$defs/stringArray"},
        "eligible": {"type": "boolean"},
        "rejection_reasons": {"$ref": "#/$defs/stringArray"},
        "deployment_settings": {"$ref": "#/$defs/settingMap"},
        "requires_engine_restart": {"type": "boolean"}
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "deployment_settings", "requires_engine_restart"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/id"},
        "deployment_settings": {"$ref": "#/$defs/settingMap"},
        "requires_engine_restart": {"type": "boolean"}
      }
    },
    "pairedEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair_count",
        "mean_directional_relative_improvement",
        "lower_directional_relative_improvement",
        "upper_directional_relative_improvement",
        "pairs"
      ],
      "properties": {
        "pair_count": {"type": "integer", "minimum": 1},
        "mean_directional_relative_improvement": {"type": "number"},
        "lower_directional_relative_improvement": {"type": "number"},
        "upper_directional_relative_improvement": {"type": "number"},
        "pairs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "comparison_group_id",
              "pair_index",
              "baseline_row_id",
              "candidate_row_id",
              "directional_relative_improvement"
            ],
            "properties": {
              "comparison_group_id": {"type": "string", "minLength": 1},
              "pair_index": {"type": "integer", "minimum": 0},
              "baseline_row_id": {"type": "string", "minLength": 1},
              "candidate_row_id": {"type": "string", "minLength": 1},
              "directional_relative_improvement": {"type": "number"}
            }
          }
        }
      }
    }
  }
}
