{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inference-autopilot:schema:graph-capture-profile:1.0",
  "title": "Inference Autopilot Graph Capture Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "algorithm_id",
    "engine_role",
    "backend",
    "graph_mode",
    "observations",
    "candidates",
    "budget",
    "objective"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "profile_id": {"$ref": "#/$defs/id"},
    "algorithm_id": {"$ref": "#/$defs/id"},
    "engine_role": {"$ref": "#/$defs/id"},
    "backend": {"enum": ["acl", "cuda", "generic"]},
    "graph_mode": {"type": "string", "minLength": 1},
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/observation"}
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "budget": {"$ref": "#/$defs/budget"},
    "objective": {"$ref": "#/$defs/objective"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "nonnegativeNumber": {"type": "number", "minimum": 0},
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "shape_size", "count", "eager_latency_ms"],
      "properties": {
        "stage_id": {"$ref": "#/$defs/id"},
        "shape_size": {"type": "integer", "minimum": 1},
        "count": {"type": "integer", "minimum": 1},
        "eager_latency_ms": {"$ref": "#/$defs/nonnegativeNumber"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_size",
        "memory_bytes",
        "capture_time_ms",
        "replay_latency_ms_by_stage"
      ],
      "properties": {
        "capture_size": {"type": "integer", "minimum": 1},
        "memory_bytes": {"type": "integer", "minimum": 0},
        "capture_time_ms": {"$ref": "#/$defs/nonnegativeNumber"},
        "replay_latency_ms_by_stage": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"$ref": "#/$defs/nonnegativeNumber"}
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_buckets",
        "memory_budget_bytes",
        "capture_time_budget_ms",
        "max_padding_ratio",
        "minimum_graph_hit_rate"
      ],
      "properties": {
        "max_buckets": {"type": "integer", "minimum": 0},
        "memory_budget_bytes": {"type": "integer", "minimum": 0},
        "capture_time_budget_ms": {"$ref": "#/$defs/nonnegativeNumber"},
        "max_padding_ratio": {"$ref": "#/$defs/nonnegativeNumber"},
        "minimum_graph_hit_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amortization_windows",
        "padding_penalty_ms_per_unit",
        "memory_penalty_ms_per_gib"
      ],
      "properties": {
        "amortization_windows": {"type": "integer", "minimum": 1},
        "padding_penalty_ms_per_unit": {"$ref": "#/$defs/nonnegativeNumber"},
        "memory_penalty_ms_per_gib": {"$ref": "#/$defs/nonnegativeNumber"}
      }
    }
  }
}
