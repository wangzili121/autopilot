{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inference-autopilot:schema:sequential-effect-spec:1.0",
  "title": "Inference Autopilot Sequential Effect Spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "effect_id",
    "analysis_mode",
    "baseline_configuration_id",
    "replay_control_configuration_id",
    "candidate_configuration_id",
    "primary_metric",
    "direction",
    "algorithm_context_sha256",
    "workload_context_sha256",
    "environment_context_sha256",
    "baseline_settings_sha256",
    "candidate_settings_sha256",
    "lower_log_effect_bound",
    "upper_log_effect_bound",
    "confidence_alpha",
    "confidence_method",
    "betting_fractions",
    "minimum_improvement_fraction",
    "minimum_decision_pairs",
    "maximum_pair_count",
    "replication_batch_pairs",
    "replication_seed_pool",
    "require_quality_constraints"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "effect_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "analysis_mode": {"enum": ["prospective", "retrospective_diagnostic"]},
    "baseline_configuration_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "replay_control_configuration_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "candidate_configuration_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "primary_metric": {"type": "string", "minLength": 1},
    "direction": {"enum": ["maximize", "minimize"]},
    "algorithm_context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workload_context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment_context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baseline_settings_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_settings_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lower_log_effect_bound": {"type": "number", "exclusiveMaximum": 0},
    "upper_log_effect_bound": {"type": "number", "exclusiveMinimum": 0},
    "confidence_alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "confidence_method": {"enum": ["betting_mixture", "finite_horizon_hoeffding"]},
    "betting_fractions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}
    },
    "minimum_improvement_fraction": {"type": "number", "minimum": 0},
    "minimum_decision_pairs": {"type": "integer", "minimum": 1},
    "maximum_pair_count": {"type": "integer", "minimum": 2, "multipleOf": 2},
    "replication_batch_pairs": {"type": "integer", "minimum": 2, "multipleOf": 2},
    "replication_seed_pool": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "require_quality_constraints": {"type": "boolean"}
  }
}
