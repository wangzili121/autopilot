{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inference-autopilot:schema:run-bundle:1.0",
  "title": "Inference Autopilot Chang Run Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_id",
    "created_at_unix",
    "run_id",
    "run_manifest_sha256",
    "working_directory",
    "command",
    "paths",
    "source",
    "compatibility"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "adapter_id": {"const": "chang-pressure-v1"},
    "created_at_unix": {"type": "number"},
    "run_id": {"type": "string", "minLength": 1},
    "run_manifest_sha256": {"$ref": "#/$defs/digest"},
    "working_directory": {"type": "string", "minLength": 1},
    "command": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string"}
    },
    "paths": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "source": {
      "type": "object",
      "required": [
        "source_config_sha256",
        "dataset_sha256",
        "snapshot_sha256",
        "git_revision",
        "git_dirty",
        "implementation_sha256"
      ],
      "properties": {
        "source_config_sha256": {"$ref": "#/$defs/digest"},
        "dataset_sha256": {
          "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
        },
        "snapshot_sha256": {"$ref": "#/$defs/digest"},
        "git_revision": {"type": ["string", "null"]},
        "git_dirty": {"type": ["boolean", "null"]},
        "implementation_sha256": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formal_eligible", "failed_checks", "checks"],
      "properties": {
        "formal_eligible": {"type": "boolean"},
        "failed_checks": {
          "type": "array",
          "items": {"type": "string"}
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status", "required_for_formal", "detail"],
            "properties": {
              "name": {"type": "string"},
              "status": {"enum": ["pass", "fail"]},
              "required_for_formal": {"type": "boolean"},
              "detail": {"type": "string"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
