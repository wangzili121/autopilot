{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inference-autopilot.local/schemas/lifecycle-execution-receipt.schema.json",
  "title": "Lifecycle Execution Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer",
    "execution_mode",
    "status",
    "lifecycle_plan_sha256",
    "selected_strategy",
    "epochs",
    "summary",
    "lifecycle_execution_receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "producer": {"type": "string"},
    "execution_mode": {"const": "validation_only"},
    "status": {"const": "diagnostic_complete"},
    "lifecycle_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "selected_strategy": {"type": "string"},
    "epochs": {"type": "array", "minItems": 1},
    "summary": {"type": "object"},
    "lifecycle_execution_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
