{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inference-autopilot:schema:policy-selection-spec:1.0",
  "title": "Inference Autopilot Policy Selection Spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "compiled_space_sha256",
    "selection_context",
    "query_static_features",
    "baseline_settings",
    "objective",
    "model"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "policy_id": {"$ref": "#/$defs/id"},
    "compiled_space_sha256": {"$ref": "#/$defs/digest"},
    "selection_context": {"$ref": "#/$defs/context"},
    "query_static_features": {"$ref": "#/$defs/scalarMap"},
    "baseline_settings": {"$ref": "#/$defs/nonEmptySettingMap"},
    "objective": {"$ref": "#/$defs/objective"},
    "model": {"$ref": "#/$defs/model"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scalar": {"type": ["boolean", "number", "string"]},
    "settingValue": {
      "oneOf": [
        {"type": ["boolean", "number", "string"]},
        {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        }
      ]
    },
    "scalarMap": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/scalar"}
    },
    "nonEmptySettingMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/settingValue"}
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {"type": "number"},
        "maximum": {"type": "number"}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm_id",
        "semantic_cohort_id",
        "graph_sha256",
        "accepted_evidence_semantic_classes",
        "workload_id",
        "environment_id",
        "static_features",
        "static_feature_ranges"
      ],
      "properties": {
        "algorithm_id": {"$ref": "#/$defs/id"},
        "semantic_cohort_id": {"$ref": "#/$defs/id"},
        "graph_sha256": {"$ref": "#/$defs/digest"},
        "accepted_evidence_semantic_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "workload_id": {"$ref": "#/$defs/id"},
        "environment_id": {"$ref": "#/$defs/id"},
        "static_features": {"$ref": "#/$defs/scalarMap"},
        "static_feature_ranges": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/range"}
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "operator", "value"],
      "properties": {
        "target": {"type": "string", "minLength": 1},
        "operator": {"enum": ["<=", ">="]},
        "value": {"type": "number"}
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "direction", "constraints"],
      "properties": {
        "target": {"type": "string", "minLength": 1},
        "direction": {"enum": ["maximize", "minimize"]},
        "constraints": {
          "type": "array",
          "items": {"$ref": "#/$defs/constraint"}
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_names",
        "neighbors",
        "distance_power",
        "maximum_normalized_distance",
        "uncertainty_multiplier",
        "maximum_failure_probability",
        "minimum_response_rows",
        "minimum_distinct_configurations",
        "minimum_paired_replicates",
        "ranked_candidate_limit"
      ],
      "properties": {
        "feature_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "neighbors": {"type": "integer", "minimum": 1},
        "distance_power": {"type": "number", "exclusiveMinimum": 0},
        "maximum_normalized_distance": {"type": "number", "minimum": 0, "maximum": 1},
        "uncertainty_multiplier": {"type": "number", "minimum": 0},
        "maximum_failure_probability": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_response_rows": {"type": "integer", "minimum": 1},
        "minimum_distinct_configurations": {"type": "integer", "minimum": 1},
        "minimum_paired_replicates": {"type": "integer", "minimum": 1},
        "ranked_candidate_limit": {"type": "integer", "minimum": 1}
      }
    }
  }
}
