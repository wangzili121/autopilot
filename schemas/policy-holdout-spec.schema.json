{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inference-autopilot:schema:policy-holdout-spec:1.0",
  "title": "Inference Autopilot Policy Holdout Spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "policy_bundle_sha256",
    "minimum_successful_replicates",
    "maximum_regret_fraction",
    "minimum_improvement_over_fallback_fraction",
    "reject_observed_failures"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "assessment_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "policy_bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "minimum_successful_replicates": {"type": "integer", "minimum": 1},
    "maximum_regret_fraction": {"type": "number", "minimum": 0},
    "minimum_improvement_over_fallback_fraction": {"type": "number"},
    "reject_observed_failures": {"type": "boolean"}
  }
}
