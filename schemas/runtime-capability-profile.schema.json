{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inference-autopilot:schema:runtime-capability-profile:1.0",
  "title": "Inference Autopilot Runtime Capability Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "environment_id", "capabilities"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "profile_id": {"$ref": "#/$defs/id"},
    "environment_id": {"$ref": "#/$defs/id"},
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/capability"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "evidence_sha256"],
      "properties": {
        "status": {"enum": ["supported", "unsupported", "unknown"]},
        "reason": {"type": "string", "minLength": 1},
        "evidence_sha256": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/digest"}
        }
      }
    }
  }
}
