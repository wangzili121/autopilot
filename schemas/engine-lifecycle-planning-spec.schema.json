{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inference-autopilot.local/schemas/engine-lifecycle-planning-spec.schema.json",
  "title": "Engine Lifecycle Planning Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lifecycle_id",
    "maximum_resident_memory_fraction",
    "preserve_run_order",
    "required_epoch_resets",
    "validation_pair_seeds"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "lifecycle_id": {"type": "string", "minLength": 1},
    "maximum_resident_memory_fraction": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "preserve_run_order": {"const": true},
    "required_epoch_resets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "validation_pair_seeds": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    }
  }
}
