{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inference-autopilot:schema:graph-profile-corpus:1.0",
  "title": "Inference Autopilot Graph Profile Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "members",
    "graph_profile_corpus_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "corpus_id": {"$ref": "#/$defs/id"},
    "members": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/member"}
    },
    "graph_profile_corpus_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regime_id", "split", "profile"],
      "properties": {
        "regime_id": {"$ref": "#/$defs/id"},
        "split": {"enum": ["train", "holdout"]},
        "profile": {"type": "object"}
      }
    }
  }
}
