{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inference-autopilot:schema:calibration-plan:1.0",
  "title": "Inference Autopilot Calibration Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "spec_sha256", "spec", "runs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "spec": {"$ref": "calibration-spec.schema.json"},
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/run"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "comparison_group_id",
        "sequence_index",
        "group_sequence_index",
        "pair_index",
        "block_index",
        "variant_role",
        "configuration_id",
        "workload_seed",
        "expected_result_path"
      ],
      "properties": {
        "run_id": {"$ref": "#/$defs/id"},
        "comparison_group_id": {"$ref": "#/$defs/id"},
        "sequence_index": {"type": "integer", "minimum": 0},
        "group_sequence_index": {"type": "integer", "minimum": 0},
        "pair_index": {"type": "integer", "minimum": 0},
        "block_index": {"type": "integer", "minimum": 0},
        "variant_role": {"enum": ["baseline", "candidate"]},
        "configuration_id": {"$ref": "#/$defs/id"},
        "workload_seed": {"type": "integer", "minimum": 0},
        "expected_result_path": {"type": "string", "minLength": 1}
      }
    }
  }
}
