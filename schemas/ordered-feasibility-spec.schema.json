{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inference-autopilot:schema:ordered-feasibility-spec:1.0",
  "title": "Inference Autopilot Ordered Feasibility Spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "probe_id",
    "parameter_name",
    "ordered_values",
    "context",
    "required_success_observations",
    "required_resource_exhausted_observations",
    "observations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "probe_id": {"$ref": "#/$defs/id"},
    "parameter_name": {"$ref": "#/$defs/id"},
    "ordered_values": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "context": {
      "allOf": [
        {"$ref": "#/$defs/scalarMap"},
        {"minProperties": 1}
      ]
    },
    "required_success_observations": {"type": "integer", "minimum": 1},
    "required_resource_exhausted_observations": {
      "type": "integer",
      "minimum": 1
    },
    "observations": {
      "type": "array",
      "items": {"$ref": "#/$defs/observation"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scalar": {"type": ["boolean", "number", "string"]},
    "scalarMap": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/scalar"}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "imported_format", "locator"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"},
        "imported_format": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_id", "value", "outcome", "source", "details"],
      "properties": {
        "attempt_id": {"$ref": "#/$defs/id"},
        "value": {"type": "integer", "minimum": 1},
        "outcome": {"enum": ["success", "resource_exhausted"]},
        "source": {"$ref": "#/$defs/source"},
        "details": {"$ref": "#/$defs/scalarMap"}
      }
    }
  }
}
