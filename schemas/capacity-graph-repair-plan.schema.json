{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inference-autopilot:schema:capacity-graph-repair-plan:1.0",
  "title": "Inference Autopilot Capacity Graph Repair Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer",
    "repair_id",
    "source",
    "comparison",
    "diagnoses",
    "repair",
    "audit",
    "capacity_graph_repair_plan_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "producer": {"type": "string", "minLength": 1},
    "repair_id": {"$ref": "#/$defs/id"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_content_sha256",
        "assessment_plan_sha256",
        "calibration_spec_sha256"
      ],
      "properties": {
        "assessment_content_sha256": {"$ref": "#/$defs/digest"},
        "assessment_plan_sha256": {"$ref": "#/$defs/digest"},
        "calibration_spec_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_group_id",
        "candidate_configuration_id",
        "primary_metric",
        "direction",
        "median_directional_relative_improvement",
        "replay_noise_envelope",
        "pair_effects"
      ],
      "properties": {
        "comparison_group_id": {"type": "string", "minLength": 1},
        "candidate_configuration_id": {"type": "string", "minLength": 1},
        "primary_metric": {"type": "string", "minLength": 1},
        "direction": {"enum": ["maximize", "minimize"]},
        "median_directional_relative_improvement": {"type": "number", "exclusiveMaximum": 0},
        "replay_noise_envelope": {"type": "number", "minimum": 0},
        "pair_effects": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      }
    },
    "diagnoses": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/diagnosis"}
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_kind",
        "active_baseline_configuration",
        "source_candidate_configuration",
        "repaired_candidate_configuration",
        "repair_delta",
        "production_delta",
        "hypothesis"
      ],
      "properties": {
        "comparison_kind": {"const": "combined_repair_against_active_baseline"},
        "active_baseline_configuration": {"$ref": "calibration-spec.schema.json#/$defs/configuration"},
        "source_candidate_configuration": {"$ref": "calibration-spec.schema.json#/$defs/configuration"},
        "repaired_candidate_configuration": {"$ref": "calibration-spec.schema.json#/$defs/configuration"},
        "repair_delta": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/delta"}
        },
        "production_delta": {
          "type": "array",
          "items": {"$ref": "#/$defs/delta"}
        },
        "hypothesis": {"type": "string", "minLength": 1}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_record_count",
        "repair_engine_count",
        "repair_changed_setting_count",
        "production_changed_setting_count"
      ],
      "properties": {
        "candidate_record_count": {"type": "integer", "minimum": 1},
        "repair_engine_count": {"type": "integer", "minimum": 1},
        "repair_changed_setting_count": {"type": "integer", "minimum": 1},
        "production_changed_setting_count": {"type": "integer", "minimum": 1}
      }
    },
    "capacity_graph_repair_plan_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_role",
        "capacity_setting",
        "capacity",
        "graph_mode_setting",
        "graph_mode",
        "capture_setting",
        "configured_capture_sizes",
        "capture_ceiling",
        "observed_running_max",
        "capacity_utilization_at_peak",
        "capture_domain_excess",
        "target_capture_size",
        "proposed_capture_sizes",
        "supporting_record_ids",
        "evidence_codes"
      ],
      "properties": {
        "engine_role": {"enum": ["base", "proposal"]},
        "capacity_setting": {"type": "string", "minLength": 1},
        "capacity": {"type": "integer", "minimum": 1},
        "graph_mode_setting": {"type": "string", "minLength": 1},
        "graph_mode": {"type": "string", "minLength": 1},
        "capture_setting": {"type": "string", "minLength": 1},
        "configured_capture_sizes": {"$ref": "#/$defs/sizes"},
        "capture_ceiling": {"type": "integer", "minimum": 1},
        "observed_running_max": {"type": "number", "exclusiveMinimum": 0},
        "capacity_utilization_at_peak": {"type": "number", "exclusiveMinimum": 0},
        "capture_domain_excess": {"type": "number", "exclusiveMinimum": 0},
        "target_capture_size": {"type": "integer", "minimum": 1},
        "proposed_capture_sizes": {"$ref": "#/$defs/sizes"},
        "supporting_record_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "evidence_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "sizes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setting", "baseline", "candidate"],
      "properties": {
        "setting": {"type": "string", "minLength": 1},
        "baseline": {},
        "candidate": {}
      }
    }
  }
}
