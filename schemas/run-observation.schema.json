{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inference-autopilot:schema:run-observation:1.0",
  "title": "Inference Autopilot Run Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_manifest_sha256",
    "started_at_unix",
    "finished_at_unix",
    "status",
    "metrics",
    "artifact",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "run_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "started_at_unix": {"type": "number"},
    "finished_at_unix": {"type": "number"},
    "status": {"enum": ["success", "oom", "crash", "cancelled"]},
    "metrics": {"type": "object"},
    "artifact": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ]
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
