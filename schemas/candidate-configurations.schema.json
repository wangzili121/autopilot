{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inference-autopilot:schema:candidate-configurations:1.0",
  "title": "Inference Autopilot Candidate Configurations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_plan_sha256", "configurations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "candidate_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "configurations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["configuration_id", "settings", "description"],
        "properties": {
          "configuration_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "settings": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": ["boolean", "number", "string"]}
          },
          "description": {"type": "string"}
        }
      }
    }
  }
}
